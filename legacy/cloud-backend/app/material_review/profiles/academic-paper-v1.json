{
  "id": "academic-paper-v1",
  "version": 1,
  "material_type": "academic_paper",
  "title": "学术论文评审",
  "scope": "问赛首版示范规范，适合自查。不作为某场比赛或学校的官方要求；赛事资料须按竞赛、年份和赛道核对。",
  "dimensions": [
    {
      "id": "innovation",
      "name": "创新性",
      "weight": 25,
      "criteria": [
        "指出研究问题、与既有工作的差异及可核查贡献",
        "区分宣称、复现和新增结果"
      ]
    },
    {
      "id": "methodology",
      "name": "研究方法",
      "weight": 30,
      "criteria": [
        "说明数据、实验设计、对照组和可复现过程",
        "识别假设、样本与测量误差"
      ]
    },
    {
      "id": "evidence",
      "name": "数据与结论",
      "weight": 30,
      "criteria": [
        "核对结果、图表、指标和结论是否对应",
        "从正文证据判断结论的适用范围与限制"
      ]
    },
    {
      "id": "writing_norms",
      "name": "规范性",
      "weight": 15,
      "criteria": [
        "检查引用、论证结构和术语一致性",
        "硬性格式以确定性检查为准"
      ]
    }
  ],
  "format_rules": [
    {
      "id": "word-fonts",
      "title": "正文字体",
      "handler": "word_fonts",
      "formats": [
        "docx"
      ],
      "severity": "error",
      "params": {
        "eastAsia": "宋体",
        "latin": "Times New Roman"
      }
    },
    {
      "id": "word-size",
      "title": "正文字号",
      "handler": "word_size",
      "formats": [
        "docx"
      ],
      "severity": "error",
      "params": {
        "pt": 12
      }
    },
    {
      "id": "word-spacing",
      "title": "正文行距",
      "handler": "word_spacing",
      "formats": [
        "docx"
      ],
      "severity": "error",
      "params": {
        "kind": "auto",
        "value": 1.5
      }
    },
    {
      "id": "word-margins",
      "title": "页边距",
      "handler": "word_margins",
      "formats": [
        "docx"
      ],
      "severity": "error",
      "params": {
        "top": 2.54,
        "bottom": 2.54,
        "left": 2.54,
        "right": 2.54
      }
    },
    {
      "id": "headings",
      "title": "标题层级",
      "handler": "heading_hierarchy",
      "formats": [
        "docx",
        "pdf",
        "txt",
        "markdown"
      ],
      "severity": "error",
      "params": {}
    },
    {
      "id": "captions",
      "title": "图表题注位置",
      "handler": "word_captions",
      "formats": [
        "docx"
      ],
      "severity": "error",
      "params": {}
    },
    {
      "id": "caption-numbers",
      "title": "图表题注编号",
      "handler": "caption_numbers",
      "formats": [
        "docx",
        "pdf",
        "txt",
        "markdown"
      ],
      "severity": "warning",
      "params": {}
    },
    {
      "id": "paper-sections",
      "title": "摘要和关键词",
      "handler": "sections",
      "formats": [
        "docx",
        "pdf",
        "txt",
        "markdown"
      ],
      "severity": "error",
      "params": {
        "required": {
          "摘要": [
            "摘要",
            "摘 要",
            "Abstract"
          ],
          "关键词": [
            "关键词",
            "关 键 词",
            "Keywords",
            "Key words"
          ]
        }
      }
    },
    {
      "id": "formula-labels",
      "title": "独立公式编号",
      "handler": "word_formula",
      "formats": [
        "docx"
      ],
      "severity": "error",
      "params": {}
    },
    {
      "id": "references",
      "title": "参考文献与条目编号",
      "handler": "references",
      "formats": [
        "docx",
        "pdf",
        "txt",
        "markdown"
      ],
      "severity": "warning",
      "params": {}
    },
    {
      "id": "paper-submission",
      "title": "文件格式和体积",
      "handler": "file_submission",
      "formats": [],
      "severity": "error",
      "params": {
        "formats": [
          "docx",
          "pdf"
        ],
        "max_bytes": 20971520
      }
    }
  ],
  "output_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "academic-paper-v1 评审结果",
    "type": "object",
    "properties": {
      "profile_id": {
        "const": "academic-paper-v1"
      },
      "summary": {
        "type": "string",
        "minLength": 1
      },
      "dimensions": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "enum": [
                "innovation",
                "methodology",
                "evidence",
                "writing_norms"
              ]
            },
            "status": {
              "enum": [
                "evaluated",
                "insufficient_evidence"
              ]
            },
            "score": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "maximum": 10
            },
            "rationale": {
              "type": "string",
              "minLength": 1
            },
            "evidence": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "block_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "source": {
                    "type": "object",
                    "properties": {
                      "path": {
                        "type": "string",
                        "minLength": 1
                      },
                      "page": {
                        "type": [
                          "integer",
                          "null"
                        ],
                        "minimum": 1
                      },
                      "slide": {
                        "type": [
                          "integer",
                          "null"
                        ],
                        "minimum": 1
                      },
                      "section": {
                        "type": [
                          "integer",
                          "null"
                        ],
                        "minimum": 1
                      },
                      "paragraph": {
                        "type": [
                          "integer",
                          "null"
                        ],
                        "minimum": 1
                      },
                      "line_start": {
                        "type": [
                          "integer",
                          "null"
                        ],
                        "minimum": 1
                      },
                      "line_end": {
                        "type": [
                          "integer",
                          "null"
                        ],
                        "minimum": 1
                      },
                      "part": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "bbox": {
                        "type": [
                          "array",
                          "null"
                        ],
                        "items": {
                          "type": "number"
                        },
                        "minItems": 4,
                        "maxItems": 4
                      },
                      "coordinate_space": {
                        "type": [
                          "string",
                          "null"
                        ]
                      }
                    },
                    "required": [
                      "path"
                    ],
                    "additionalProperties": false
                  },
                  "excerpt": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "minLength": 1
                  }
                },
                "required": [
                  "block_id",
                  "source",
                  "excerpt"
                ],
                "additionalProperties": false
              }
            },
            "suggestions": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "id",
            "status",
            "score",
            "rationale",
            "evidence",
            "suggestions"
          ],
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "status": {
                    "const": "evaluated"
                  }
                }
              },
              "then": {
                "properties": {
                  "score": {
                    "type": "integer"
                  },
                  "evidence": {
                    "minItems": 1
                  }
                }
              },
              "else": {
                "properties": {
                  "score": {
                    "type": "null"
                  }
                }
              }
            }
          ]
        },
        "minItems": 4,
        "maxItems": 4
      },
      "priority_actions": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "priority": {
              "enum": [
                "high",
                "medium",
                "low"
              ]
            },
            "action": {
              "type": "string",
              "minLength": 1
            },
            "block_id": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "priority",
            "action",
            "block_id"
          ],
          "additionalProperties": false
        }
      }
    },
    "required": [
      "profile_id",
      "summary",
      "dimensions",
      "priority_actions"
    ],
    "additionalProperties": false
  },
  "knowledge_refs": [
    "challenge-cup-2019-charter",
    "mcm-2026-format",
    "case-challenge-method",
    "case-mcm-abstract"
  ]
}
