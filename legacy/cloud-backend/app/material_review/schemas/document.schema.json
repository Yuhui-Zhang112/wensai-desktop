{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "format": {
      "enum": [
        "docx",
        "pptx",
        "pdf",
        "txt",
        "markdown"
      ]
    },
    "filename": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": [
        "string",
        "null"
      ]
    },
    "raw_text": {
      "type": [
        "string",
        "null"
      ]
    },
    "metadata": {
      "type": "object"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "page": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 1
                  },
                  "slide": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 1
                  },
                  "section": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 1
                  },
                  "paragraph": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 1
                  },
                  "line_start": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 1
                  },
                  "line_end": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 1
                  },
                  "part": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "bbox": {
                    "type": [
                      "array",
                      "null"
                    ],
                    "items": {
                      "type": "number"
                    },
                    "minItems": 4,
                    "maxItems": 4
                  },
                  "coordinate_space": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "required": [
                  "path"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "code",
          "message",
          "source"
        ],
        "additionalProperties": false
      }
    },
    "blocks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "enum": [
              "title",
              "heading",
              "paragraph",
              "image",
              "table",
              "cell",
              "formula",
              "page",
              "slide",
              "shape",
              "textbox"
            ]
          },
          "text": {
            "type": "string"
          },
          "level": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "parent_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "source": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "page": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1
              },
              "slide": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1
              },
              "section": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1
              },
              "paragraph": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1
              },
              "line_start": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1
              },
              "line_end": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1
              },
              "part": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "bbox": {
                "type": [
                  "array",
                  "null"
                ],
                "items": {
                  "type": "number"
                },
                "minItems": 4,
                "maxItems": 4
              },
              "coordinate_space": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "path"
            ],
            "additionalProperties": false
          },
          "attrs": {
            "type": "object"
          }
        },
        "required": [
          "id",
          "type",
          "text",
          "level",
          "parent_id",
          "source",
          "attrs"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "format",
    "filename",
    "title",
    "raw_text",
    "metadata",
    "warnings",
    "blocks"
  ],
  "additionalProperties": false
}
