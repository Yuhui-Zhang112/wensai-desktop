{
  "id": "competition-proposal-review",
  "version": 1,
  "material_type": "competition_proposal",
  "inputs": [
    "approved_text",
    "separately_approved_PPT_images",
    "profile.dimensions",
    "retrieved_reference_notes"
  ],
  "steps": [
    "核对目标面向谁、如何验证、与现有方案有什么差异。",
    "对照方案、进度、责任人、交付物与验收节点。",
    "核对预算分项、资源缺口与风险应对；只把对应届次规则作为参考。"
  ],
  "scoring": "0–2：证据显示严重缺陷；3–5：主要环节缺失；6–8：基本成立且有明确改进处；9–10：证据充分。没有直接证据时省略该维度。",
  "criterion_ids": [
    "objective",
    "solution",
    "schedule",
    "budget",
    "resources",
    "risk"
  ],
  "citations": "只引用本段 ref；文字引用连续原句，图片引用对象并把 quote 填 null。",
  "standards": [
    {
      "id": "objective",
      "name": "目标",
      "weight": 20,
      "criteria": [
        "说明需求来源、服务对象、项目边界和可量化的验收指标"
      ]
    },
    {
      "id": "solution",
      "name": "方案",
      "weight": 25,
      "criteria": [
        "技术路线可落地，有与现有方案的对比和验证计划"
      ]
    },
    {
      "id": "schedule",
      "name": "进度",
      "weight": 15,
      "criteria": [
        "给出阶段、责任人、依赖、交付物和验收节点"
      ]
    },
    {
      "id": "budget",
      "name": "预算",
      "weight": 15,
      "criteria": [
        "列出分项、数量、单价、总额和估算依据"
      ]
    },
    {
      "id": "resources",
      "name": "资源",
      "weight": 10,
      "criteria": [
        "说明团队分工、已有条件、协作资源和关键缺口"
      ]
    },
    {
      "id": "risk",
      "name": "风险",
      "weight": 15,
      "criteria": [
        "明确触发条件、影响、应对措施和备选方案"
      ]
    }
  ],
  "chunk_output_schema": {
    "$defs": {
      "ModelDimension": {
        "additionalProperties": false,
        "properties": {
          "criterion": {
            "maxLength": 512,
            "minLength": 1,
            "title": "Criterion",
            "type": "string"
          },
          "score": {
            "maximum": 10,
            "minimum": 0,
            "title": "Score",
            "type": "integer"
          },
          "rationale": {
            "maxLength": 700,
            "minLength": 1,
            "title": "Rationale",
            "type": "string"
          },
          "evidence": {
            "items": {
              "$ref": "#/$defs/ModelEvidence"
            },
            "maxItems": 3,
            "minItems": 1,
            "title": "Evidence",
            "type": "array"
          }
        },
        "required": [
          "criterion",
          "score",
          "rationale",
          "evidence"
        ],
        "title": "ModelDimension",
        "type": "object"
      },
      "ModelEvidence": {
        "additionalProperties": false,
        "properties": {
          "ref": {
            "pattern": "^[ti][0-9]+$",
            "title": "Ref",
            "type": "string"
          },
          "quote": {
            "anyOf": [
              {
                "maxLength": 400,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Quote"
          }
        },
        "required": [
          "ref",
          "quote"
        ],
        "title": "ModelEvidence",
        "type": "object"
      },
      "ModelIssue": {
        "additionalProperties": false,
        "properties": {
          "criterion": {
            "maxLength": 512,
            "minLength": 1,
            "title": "Criterion",
            "type": "string"
          },
          "standard_index": {
            "maximum": 20,
            "minimum": 0,
            "title": "Standard Index",
            "type": "integer"
          },
          "impact": {
            "enum": [
              "invalidates",
              "weakens",
              "presentation"
            ],
            "title": "Impact",
            "type": "string"
          },
          "evidence": {
            "$ref": "#/$defs/ModelEvidence"
          },
          "suggestion": {
            "maxLength": 700,
            "minLength": 1,
            "title": "Suggestion",
            "type": "string"
          }
        },
        "required": [
          "criterion",
          "standard_index",
          "impact",
          "evidence",
          "suggestion"
        ],
        "title": "ModelIssue",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "dimensions": {
        "items": {
          "$ref": "#/$defs/ModelDimension"
        },
        "maxItems": 6,
        "title": "Dimensions",
        "type": "array"
      },
      "issues": {
        "items": {
          "$ref": "#/$defs/ModelIssue"
        },
        "maxItems": 6,
        "title": "Issues",
        "type": "array"
      }
    },
    "required": [
      "dimensions",
      "issues"
    ],
    "title": "ChunkReview",
    "type": "object"
  },
  "merged_review_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "competition-proposal-v1 评审结果",
    "type": "object",
    "properties": {
      "profile_id": {
        "const": "competition-proposal-v1"
      },
      "summary": {
        "type": "string",
        "minLength": 1
      },
      "dimensions": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "enum": [
                "objective",
                "solution",
                "schedule",
                "budget",
                "resources",
                "risk"
              ]
            },
            "status": {
              "enum": [
                "evaluated",
                "insufficient_evidence"
              ]
            },
            "score": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "maximum": 10
            },
            "rationale": {
              "type": "string",
              "minLength": 1
            },
            "evidence": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "block_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "source": {
                    "type": "object",
                    "properties": {
                      "path": {
                        "type": "string",
                        "minLength": 1
                      },
                      "page": {
                        "type": [
                          "integer",
                          "null"
                        ],
                        "minimum": 1
                      },
                      "slide": {
                        "type": [
                          "integer",
                          "null"
                        ],
                        "minimum": 1
                      },
                      "section": {
                        "type": [
                          "integer",
                          "null"
                        ],
                        "minimum": 1
                      },
                      "paragraph": {
                        "type": [
                          "integer",
                          "null"
                        ],
                        "minimum": 1
                      },
                      "line_start": {
                        "type": [
                          "integer",
                          "null"
                        ],
                        "minimum": 1
                      },
                      "line_end": {
                        "type": [
                          "integer",
                          "null"
                        ],
                        "minimum": 1
                      },
                      "part": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "bbox": {
                        "type": [
                          "array",
                          "null"
                        ],
                        "items": {
                          "type": "number"
                        },
                        "minItems": 4,
                        "maxItems": 4
                      },
                      "coordinate_space": {
                        "type": [
                          "string",
                          "null"
                        ]
                      }
                    },
                    "required": [
                      "path"
                    ],
                    "additionalProperties": false
                  },
                  "excerpt": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "minLength": 1
                  }
                },
                "required": [
                  "block_id",
                  "source",
                  "excerpt"
                ],
                "additionalProperties": false
              }
            },
            "suggestions": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "id",
            "status",
            "score",
            "rationale",
            "evidence",
            "suggestions"
          ],
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "status": {
                    "const": "evaluated"
                  }
                }
              },
              "then": {
                "properties": {
                  "score": {
                    "type": "integer"
                  },
                  "evidence": {
                    "minItems": 1
                  }
                }
              },
              "else": {
                "properties": {
                  "score": {
                    "type": "null"
                  }
                }
              }
            }
          ]
        },
        "minItems": 6,
        "maxItems": 6
      },
      "priority_actions": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "priority": {
              "enum": [
                "high",
                "medium",
                "low"
              ]
            },
            "action": {
              "type": "string",
              "minLength": 1
            },
            "block_id": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "priority",
            "action",
            "block_id"
          ],
          "additionalProperties": false
        }
      }
    },
    "required": [
      "profile_id",
      "summary",
      "dimensions",
      "priority_actions"
    ],
    "additionalProperties": false
  }
}
