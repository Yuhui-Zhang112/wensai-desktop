{
  "$defs": {
    "RunMeta": {
      "additionalProperties": false,
      "properties": {
        "task_id": {
          "pattern": "^[A-Za-z0-9_.:-]{1,100}$",
          "title": "Task Id",
          "type": "string"
        },
        "revision_id": {
          "pattern": "^[A-Za-z0-9_.:-]{1,100}$",
          "title": "Revision Id",
          "type": "string"
        },
        "profile_id": {
          "pattern": "^[A-Za-z0-9_.:-]{1,100}$",
          "title": "Profile Id",
          "type": "string"
        },
        "profile_version": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Profile Version"
        },
        "skill_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Skill Id"
        },
        "skill_version": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Skill Version"
        },
        "provider": {
          "enum": [
            "mock",
            "deepseek"
          ],
          "title": "Provider",
          "type": "string"
        },
        "model": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "finished_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Finished At"
        },
        "status": {
          "enum": [
            "running",
            "completed",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        },
        "text_count": {
          "default": 0,
          "title": "Text Count",
          "type": "integer"
        },
        "image_count": {
          "default": 0,
          "title": "Image Count",
          "type": "integer"
        },
        "chunk_count": {
          "default": 0,
          "title": "Chunk Count",
          "type": "integer"
        },
        "reference_ids": {
          "items": {
            "type": "string"
          },
          "title": "Reference Ids",
          "type": "array"
        }
      },
      "required": [
        "task_id",
        "revision_id",
        "profile_id",
        "provider",
        "model",
        "started_at",
        "status"
      ],
      "title": "RunMeta",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "meta": {
      "$ref": "#/$defs/RunMeta"
    },
    "code": {
      "maxLength": 512,
      "minLength": 1,
      "title": "Code",
      "type": "string"
    },
    "message": {
      "maxLength": 512,
      "minLength": 1,
      "title": "Message",
      "type": "string"
    }
  },
  "required": [
    "meta",
    "code",
    "message"
  ],
  "title": "Failure",
  "type": "object"
}
